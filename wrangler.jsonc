{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenta-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agenta-web"
    }
  ],
  // Public Firebase web config (safe in client). Applied on deploy —
  // no need to add Variables in the Cloudflare dashboard for a
  // static-assets-only Worker.
  "vars": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyCXyW9C51srKdyNfgx4K0_x89r0XTa4VS4",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "agenta-c1d6b.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "agenta-c1d6b",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "agenta-c1d6b.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "330861771071",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:330861771071:web:a504e26273fa1a37a0bb8a",
    "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-R0D84J88GN"
  }
}
